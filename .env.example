# Names only. Copy to .env (chmod 600) and fill in. Never commit real values.

# Platåberget Glamsterdam devnet (chainId 7091047534)
GLAMSTERDAM_RPC_URL=
# The devnet actor: owner of both vaults in the run and of the mainnet USDT copy (it can issue()).
GLAMSTERDAM_PRIVATE_KEY=
# Self-bundles the sponsored 7702 + 4337 claimSelf. Needs ETH.
BUNDLER_PRIVATE_KEY=

# Contracts already on the devnet
ENTRY_POINT_ADDRESS=
SIMPLE_7702_ACCOUNT_ADDRESS=
GLAMSTERDAM_USDT_COPY_ADDRESS=

# Real Ethereum L1, read-only. Only the fidelity check uses it: it hashes mainnet USDT's code and
# compares it with the devnet copy's. Unset, the report records the comparison as "not checked".
# Any public endpoint works, e.g. https://ethereum-rpc.publicnode.com or https://rpc.mevblocker.io
MAINNET_RPC_URL=

# Optional: reuse deployments made by an earlier run
# LEGACY_VAULT_ADDRESS=
# RING_VAULT_ADDRESS=

# Run parameters (defaults in the script)
# RESERVATION_TTL_SECONDS=60
# AMOUNT_USDT=10
# MAX_SPONSORED_FEE_PER_GAS=

# ---------------------------------------------------------------- TRON (Nile)
# The TRON run keeps its generated keyset and deployed addresses in .env.nile, which
# `npm run accounts:tron` creates (mode 600) and .gitignore excludes. Only the TronGrid
# key belongs here. Optional: Nile answers unauthenticated requests, but TronGrid's free
# tier throttles harder without a key. Get one free at https://www.trongrid.io.
TRON_GRID_API_KEY=
# Optional, read from .env or .env.nile: TRX deploy:tron stakes on the sponsor (default 1500),
# and the first of the three ring indices the run uses (default: random, never used).
# SPONSOR_STAKE_TRX=
# RING_IDX_BASE=
