{
  "name": "bridge-ring-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Muun prefunded USDT bridge vault with reservations in a ring of reusable storage slots, measured under Glamsterdam gas rules and on TRON Nile against the mapping-based vault.",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "lint": "forge lint",
    "measure:glam": "forge build && node scripts/measure-glamsterdam-vault.mjs",
    "render:glam": "node scripts/measure-glamsterdam-vault.mjs render",
    "build:tron": "forge build --root tron",
    "test:tron": "forge test --root tron",
    "accounts:tron": "node scripts/tron/gen-accounts.mjs",
    "fund:tron": "node scripts/tron/fund.mjs",
    "deploy:tron": "npm run build:tron && node scripts/tron/deploy.mjs",
    "measure:tron": "npm run build:tron && node scripts/tron/measure-tron-vault.mjs && node scripts/tron/render-tron-vault.mjs",
    "render:tron": "node scripts/tron/render-tron-vault.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "account-abstraction": "github:eth-infinitism/account-abstraction#v0.9.0",
    "dotenv": "17.2.1",
    "tronweb": "6.4.0",
    "viem": "2.33.3"
  },
  "devDependencies": {
    "forge-std": "github:foundry-rs/forge-std#v1.10.0"
  }
}
